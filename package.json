{
  "name": "tempo",
  "version": "1.0.0",
  "description": "Desktop Productivity Engine with Unmissable Reminders that Bypass Windows Do Not Disturb",
  "main": "main.js",
  "author": "Surya Ramadhan",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:all": "electron-builder -wl"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.tempo.desktop",
    "productName": "Tempo",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "src/renderer/assets/tempo-logo.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "src/renderer/assets/tempo-logo.png",
      "category": "Utility",
      "synopsis": "Desktop Productivity Engine with Unmissable Reminders",
      "description": "TEMPO Desktop Productivity Engine with forced screen-saver alerts that pierce through Do Not Disturb, interactive graph view, markdown logbook, and activity vault."
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
